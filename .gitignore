# Docs: каталог в целом игнорируется (временные файлы),
# но черновики юридических документов должны попадать в репозиторий.
# Внимание: нельзя писать `docs/` — git не заходит в исключённый каталог,
# поэтому отрицание внутри него не сработало бы.
docs/*
!docs/legal/
!docs/legal/*.md
